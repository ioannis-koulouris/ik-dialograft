{
  "name": "dialograft",
  "version": "0.1.0",
  "private": true,
  "description": "Software evolves through conversation — invoicing SaaS demo with MCP, agentic feature requests and a sandboxed coding runner.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir tests --testTimeout 20000",
    "contracts": "tsx scripts/gen-contracts.ts",
    "migrate": "node dist/src/cli/migrate.js",
    "seed": "node dist/src/cli/seed.js",
    "sweep-exports": "node dist/src/cli/sweep-exports.js",
    "start:api": "node dist/src/api/main.js",
    "start:mcp": "node dist/src/mcp/main.js",
    "start:worker": "node dist/src/worker/main.js",
    "start:runner": "node dist/src/runner/main.js",
    "dev:api": "tsx src/api/main.ts",
    "dev:mcp": "tsx src/mcp/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}

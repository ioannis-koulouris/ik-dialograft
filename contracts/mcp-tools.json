              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "behavior": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "exceptions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "assumptions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "openQuestions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "acceptanceCriteria": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "decisions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "minLength": 1,

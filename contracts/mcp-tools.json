          "minLength": 8,
          "maxLength": 100
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "configure_payment_reminders_2",
    "description": "Run a second payment reminder check (Mahnstufe 2). Sends one reminder email per invoice that is at least 30 days overdue and not yet fully paid, but only if a first reminder (Mahnstufe 1) was already sent. Uses the optional asOf reference date (default: today).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",

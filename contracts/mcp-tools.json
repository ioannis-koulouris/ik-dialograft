        }
      },
      "required": [
        "featureRequestId",
        "scope"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "confirm_feature_scope",
    "description": "Confirm the summarized scope version after the user explicitly agreed. Queues ticket creation and assessment.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",

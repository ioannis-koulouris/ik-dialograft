  {
    "name": "record_payment",
    "description": "Record a confirmed (partial) payment. Overpayment is rejected.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "invoice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amountCents": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "confirm": {
          "type": "boolean",
          "const": true,
          "description": "Must be true and only set after the user explicitly confirmed this action."
        },
        "idempotencyKey": {
          "description": "Optional key; repeating a call with the same key returns the first result.",
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        }
      },
      "required": [
        "invoice",
        "amountCents",
        "reference",
        "confirm"
      ],
      "additionalProperties": false
    }
  },

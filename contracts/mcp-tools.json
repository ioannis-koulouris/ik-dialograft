[
  {
    "name": "list_capabilities",
    "description": "List the tools that currently exist and known product gaps. Use before telling the user a function is missing.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "create_customer",
    "description": "Create a customer. Email must be a demo .invalid address.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "contactName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "idempotencyKey": {
          "description": "Optional key; repeating a call with the same key returns the first result.",
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        }
      },
      "required": [
        "name",
        "contactName",
        "email"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "search_customers",
    "description": "Search customers by name, contact, number or email.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "update_customer_contact",
    "description": "Change contact person and/or billing email of a customer. Ambiguous references return candidates.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "customer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contactName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "idempotencyKey": {
          "description": "Optional key; repeating a call with the same key returns the first result.",
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        }
      },
      "required": [
        "customer"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "create_quote",
    "description": "Create a business quote with lines; net, tax and gross are computed in cents.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "customer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "lines": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "unitPriceCents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "taxRatePct": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 7
                  },
                  {
                    "type": "number",
                    "const": 19
                  }
                ]
              }
            },
            "required": [
              "description",
              "quantity",
              "unitPriceCents",
              "taxRatePct"
            ],
            "additionalProperties": false
          }
        },
        "idempotencyKey": {
          "description": "Optional key; repeating a call with the same key returns the first result.",
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        }
      },
      "required": [
        "customer",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "get_quote",
    "description": "Get a business quote by id or number.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "quote"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "accept_quote",
    "description": "Record the customer's confirmed acceptance of a business quote.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "confirm": {
          "type": "boolean",
          "const": true,
          "description": "Must be true and only set after the user explicitly confirmed this action."
        },
        "idempotencyKey": {
          "description": "Optional key; repeating a call with the same key returns the first result.",
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        }
      },
      "required": [
        "quote",
        "confirm"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "create_invoice_from_quote",
    "description": "Create a test invoice draft from an accepted quote.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",

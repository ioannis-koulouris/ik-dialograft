          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "cursors"
      ],
      "additionalProperties": false
    }
  }

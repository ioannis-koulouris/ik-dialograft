  {
    "name": "list_feature_requests",
    "description": "List feature requests and their status.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "draft_feature_request",
    "description": "Start a feature request after the user agreed to have a missing function checked. Put everything the user already said into scope so it is not asked again. Returns missing fields; ask about them one at a time.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "request": {
          "type": "string",
          "minLength": 3,
          "maxLength": 4000
        },
        "scope": {
          "type": "object",
          "properties": {
            "goal": {
              "type": "string",
              "maxLength": 1000
            },
            "trigger": {
              "type": "string",
              "maxLength": 1000
            },
            "affectedData": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "behavior": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "exceptions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "assumptions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "openQuestions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "acceptanceCriteria": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "decisions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "answer": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "confirmed",
                      "proposed",
                      "unknown"
                    ],
                    "description": "proposed = suggestion not yet confirmed by the user"
                  }
                },
                "required": [
                  "topic",
                  "answer",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "idempotencyKey": {
          "description": "Optional key; repeating a call with the same key returns the first result.",
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        }
      },
      "required": [
        "title",
        "request"
      ],
      "additionalProperties": false
    }
  },

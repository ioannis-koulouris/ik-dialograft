      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "paymentTermDays": {
          "default": 14,
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "idempotencyKey": {
          "description": "Optional key; repeating a call with the same key returns the first result.",
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        }
      },
      "required": [
        "quote"
      ],
      "additionalProperties": false
    }
  },
  {

TENANT_ID=demo-tenant
DEMO_TODAY=2026-10-30
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-coder:30b
GITHUB_TOKEN=
GITHUB_REPO=ioannis-koulouris/dialograft
SMTP_HOST=mailpit
SMTP_PORT=1025
DEV_RATE_EUR_PER_HOUR=100
DEV_RISK_SURCHARGE_PCT=20

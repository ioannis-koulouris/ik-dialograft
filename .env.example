API_PORT=8080
MCP_PORT=8081
API_BASE_URL=http://127.0.0.1:8080
# Client -> MCP
MCP_CLIENT_TOKEN=
# MCP -> API
API_SERVICE_TOKEN=
# Operator only, never given to MCP clients
OPERATOR_TOKEN=
# Worker -> API internal endpoints / runner
RUNNER_TOKEN=
RUNNER_URL=http://host.docker.internal:8090
